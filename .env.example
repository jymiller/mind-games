# Copy this file to .env (gitignored) and paste your real values.
# PLACEHOLDERS ONLY — never commit real keys.

# ── XTrace Memory API ────────────────────────────────────────────────
# From https://docs.xtrace.ai ("Get your API key")
XTRACE_API_KEY=xtk_paste_your_key_here
XTRACE_ORG_ID=org_paste_your_org_id_here
# Optional; defaults to https://api.production.xtrace.ai
# XTRACE_BASE_URL=

# ── Novita — inference (OpenAI-compatible) ───────────────────────────
# https://novita.ai — $1,000 in won credits on this account.
NOVITA_API_KEY=paste_your_novita_key_here
# Base URL is https://api.novita.ai/openai/v1
# Model slugs DRIFT — pull the live list and pin one here, don't hardcode in code:
#   curl -s https://api.novita.ai/openai/v1/models \
#     -H "Authorization: Bearer $NOVITA_API_KEY" | jq -r '.data[].id'
NOVITA_MODEL=paste_a_slug_from_the_models_endpoint

# ── Render — web hosting ─────────────────────────────────────────────
# PORT is injected by Render at runtime; bind process.env.PORT and host 0.0.0.0.
# Set locally only if you want a non-default local port.
PORT=3000
# Set on the Render dashboard (or render.yaml with sync:false), never in git:
#   XTRACE_API_KEY, XTRACE_ORG_ID, NOVITA_API_KEY, NOVITA_MODEL
# Optional, only if you add managed Postgres for a durable attestation register:
# DATABASE_URL=

# ── XTrace scope axes — domain vs dev memory (see INFRASTRUCTURE.md §4) ──
# These are scope NAMES, not secrets. They keep build notes out of covenant recall.
XTRACE_DOMAIN_APP_ID=deal-memory
XTRACE_DEV_USER_ID=mg-build
XTRACE_DEV_APP_ID=mind-games-build
XTRACE_DEV_NAMESPACE=repo:mind-games
