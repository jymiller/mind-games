{
  "name": "mind-games",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Mind Games AI Hackathon (agent memory) — built on the XTrace Memory API",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "smoke": "node smoke.js",
    "check:flip": "node check-flip.mjs",
    "exp0": "node experiments/exp0-latency.js",
    "exp1": "node experiments/exp1-supersession.js",
    "exp2": "node experiments/exp2-retraction.js",
    "exp3": "node experiments/exp3-handoff.js",
    "exp4": "node experiments/exp4-trigger.js",
    "exp5": "node experiments/exp5-eval-toggle.js",
    "exp6": "node experiments/exp6-quota.js",
    "experiments": "for e in 0 1 2 3 4 5 6; do node experiments/exp$e-*.js; done",
    "check:ablation": "node check-ablation.mjs",
    "check:card": "node check-card.mjs",
    "check:gate": "node check-gate.mjs",
    "check:drift": "node check-drift.mjs",
    "check:openbox": "node check-openbox.mjs",
    "check:chain": "node check-chain.mjs",
    "check": "for c in flip ablation card gate drift openbox chain; do npm run -s check:$c || exit 1; done"
  },
  "dependencies": {
    "@xtraceai/memory": "^0.5.0"
  }
}
